# 이 파일을 .env.local로 복사한 뒤 값을 채우세요.
# NEXT_PUBLIC_* 은 클라이언트 번들에 그대로 포함됩니다 — 공개해도 되는 값만 넣으세요.

# ── Supabase (필수) ──────────────────────────────────────────
# 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Google OAuth (필수) ──────────────────────────────────────
# Google Cloud Console > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Maps (지도·스토리 화면에서 필요) ──────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_API_KEY=

# ── Sentry (선택 — 비우면 에러 모니터링만 비활성화) ──────────
NEXT_PUBLIC_SENTRY_DSN=
# 아래 3개는 빌드 시 소스맵 업로드에만 쓰입니다 (없으면 조용히 건너뜁니다)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── 체험용 공용 테스트 계정 (선택) ───────────────────────────
# 로그인 화면의 "체험하기" 버튼이 사용합니다. 누구나 쓰도록 공개하는 계정입니다.
NEXT_PUBLIC_TEST_ACCOUNT_EMAIL=
NEXT_PUBLIC_TEST_ACCOUNT_PASSWORD=
